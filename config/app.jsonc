{
    "start-scene": "menu",
    "window":
    {
        "title":"Default Game Window",
        "size":{
            "width":1280,
            "height":720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer":{
            "sky": "assets/textures/sky_2.png",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets":{
            "shaders":{
                "tinted":{
                    "vs":"assets/shaders/tinted.vert",
                    "fs":"assets/shaders/tinted.frag"
                },
                "textured":{
                    "vs":"assets/shaders/textured.vert",
                    "fs":"assets/shaders/textured.frag"
                },
                "lit": {
                    "vs": "assets/shaders/light_transform.vert",
                    "fs": "assets/shaders/light_array.frag"
                }
            },
            "textures":{
                "moon": "assets/textures/moon.jpg",
                "ground": "assets/textures/ground.png",
                "wood": "assets/textures/wood.jpg",
                "glass": "assets/textures/glass-panels.png",
                "monkey": "assets/textures/monkey.png",
                "villain": "assets/textures/villain_diffuse.png",
                "wall": "assets/textures/wall.png",
                "fire_ball" : "assets/textures/fire_ball.png",
                "aladdin" : "assets/textures/lilo.png"
            },
            "meshes":{
                "villain" : "assets/models/villain.obj",
                "monkey": "assets/models/monkey.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj",
                "wall": "assets/models/wall.obj",
                "ball" : "assets/models/ball.obj",
                "aladdin" : "assets/models/aladdin4.obj"
            },
            "samplers":{
                "default":{},
                "pixelated":{
                    "MAG_FILTER": "GL_LINEAR"
                },
                "MAX_ANISOTROPY": 2.0
            },
            "materials":{
                "metal":{
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [0.45, 0.4, 0.5, 1]
                },
                "glass":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        },
                        "blending":{
                            "enabled": true,
                            "sourceFactor": "GL_SRC_ALPHA",
                            "destinationFactor": "GL_ONE_MINUS_SRC_ALPHA"
                        },
                        "depthMask": false
                    },
                    "transparent": true,
                    "tint": [1, 1, 1, 1],
                    "texture": "glass",
                    "sampler": "pixelated"
                },
                "ground":{
                    "type": "lit",
                    "shader": "lit",
                    "emissionMap": "assets/textures/moon.jpg",
                    "aoMap": "assets/textures/moon.jpg",
                    "roughnessMap": "assets/textures/moon.jpg",
                    "specularMap": "assets/textures/moon.jpg",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "ground",
                    "sampler": "default"
                },
                "monkey":{
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "monkey",
                    "sampler": "default"
                },
                "villain":{
                    "type": "lit",
                    "shader": "lit",
                    "aoMap": "assets/textures/texture001.png",
                    "roughnessMap": "assets/textures/villain_roughness.png",
                    "specularMap": "assets/textures/moon.jpg",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "texture": "villain",
                    "sampler": "default"
                },
                "aladdin":{
                    "type": "lit",
                    "shader": "lit",
                    "emissionMap": "assets/textures/aladdin_emit.png",
                    "aoMap": "assets/textures/aov_aladdin.png",
                    "roughnessMap": "assets/textures/texture002.png",
                    "specularMap": "assets/textures/moon.jpg",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "texture": "aladdin",
                    "sampler": "default"
                },
                "wall":{
                    "type": "lit",
                    "shader": "lit",
                    "emissionMap": "assets/textures/moon.jpg",
                    "aoMap": "assets/textures/moon.jpg",
                    "roughnessMap": "assets/textures/moon.jpg",
                    "specularMap": "assets/textures/moon.jpg",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "wall",
                    "sampler": "default"
                },
                "fire_ball":{
                    "type": "lit",
                    "shader": "lit",
                    "emissionMap": "assets/textures/moon.jpg",
                    "aoMap": "assets/textures/moon.jpg",
                    "roughnessMap": "assets/textures/moon.jpg",
                    "specularMap": "assets/textures/moon.jpg",
                    "pipelineState": {
                        "faceCulling":{
                            "enabled": false
                        },
                        "depthTesting":{
                            "enabled": true
                        }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "fire_ball",
                    "sampler": "default"
                }
            }
        },
        "world":[
            {
                "position": [0, 1, 12],
                "rotation": [10, 0, 0],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Free Camera Controller"
                    }
                ],
                "children": [
                    {
                        "name": "aladdin",
                        "position": [0, -1, -2],
                        "scale": [0.2, 0.2, 0.2],
                        "rotation": [-10, 180, 0],
                        "components": [
                            {
                                "type": "Mesh Renderer",
                                "mesh": "aladdin",
                                "material": "aladdin"
                            },
                            {
                                "type": "Collision",
                                "x" : 1.1,
                                "y" : 1.6,
                                "z" : 0.346  
                            }
                        ]
                    }
                ]
            },
            {
                "position": [0, 0, 0],
                "rotation": [-90, 0, 0],
                "scale": [50, 50, 1],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "plane",
                        "material": "ground"
                    }
                ]
            },
            { 
                "name" : "villain",
                "rotation" : [0, -90, 0],
                "position" : [0, 3.5, -3], // change villain
                "scale" : [1.5, 1.5, 1.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "villain",
                        "material": "villain"
                    }
                ]
            },
            { 
                "name" : "left_wall",
                "position" : [-6, 0, 3],
                "rotation" : [0, 90, 0],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "wall",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "x" : 2.2,
                        "y" : 3.18,
                        "z" : 7.15
                    }
                ]
            },
            { 
                "name" : "right_wall",
                "position" : [6, 0, 3],
                "rotation" : [0, -90, 0],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "wall",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "x" : 2,
                        "y" : 3.18,
                        "z" : 7.15
                    }
                ]
            },
            {
                "position": [0, 1, 0],
                "rotation": [0, 0, 0],
                "scale": [0.25, 0.25 , 0.25],
                "hide" : true,
                "threshold" : 1.0,
                "components": [
                    {
                        "type": "Generate"
                    },
                    {
                        "type": "Mesh Renderer",
                        "mesh": "ball",
                        "material": "fire_ball"
                    },
                    {
                        "type": "Movement",
                        "linearVelocity" : [0, 0, 3],
                        "angularVelocity" : [0, 0, 0]   
                    },
                    {
                        "type": "Collision",
                        "x" : 0.25,
                        "y" : 0.25,
                        "z" : 0.25
                    }
                ]
            },
            {
                "position": [0, 0, 5],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "Directional",
                        "direction": [0.5, 0, 1.0],
                        "lightPosition": [0, 0, 5],
                        "color": [1.0, 1.0, 1.0],
                        "attenuation": {
                            "constant": 1.0,
                            "linear": 0.09,
                            "quadratic": 0.032
                        },
                        "spot_angle": {
                            "inner": 5,
                            "outer": 10
                        }
                    }
                ]
            }
        ]
    }
}